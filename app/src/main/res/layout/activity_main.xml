<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- First-load overlay: keeps the branded splash on screen until the
         web auth check is done, instead of the blank black screen seen
         between the logo splash and the feed. Smooth-loading, dots
         revision (2026-11-01): this looks identical to the web
         web loading screen (64dp logo + 6 pulsing dots + "Loading…",
         same #1e2530 dark background), so the native overlay and the web
         loading screen read as ONE continuous screen. Hidden by
         MainActivity when the web app signals auth-ready
         (NativeBridge.notifyAuthReady) or by the 15s safety timeout, so
         it can never get stuck. -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/frianzo_dark_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Frianzo"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:id="@+id/loading_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dot1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

            <ImageView
                android:id="@+id/dot2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

            <ImageView
                android:id="@+id/dot3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

            <ImageView
                android:id="@+id/dot4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

            <ImageView
                android:id="@+id/dot5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

            <ImageView
                android:id="@+id/dot6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:contentDescription="@null"
                android:src="@drawable/loading_dot" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading…"
            android:textColor="#64748b"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
