<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- First-load overlay: keeps the branded splash on screen until the
         web auth check is done, instead of the blank black screen seen
         between the logo splash and the feed. Smooth-loading (2026-11-01):
         this now looks identical to the web LoadingState (64dp logo +
         24dp ring spinner + "Loading…", same #1e2530 dark background), so
         the native overlay and the web loading screen read as ONE
         continuous screen, not dots -> ring. Hidden by MainActivity when
         the web app signals auth-ready (NativeBridge.notifyAuthReady) or
         by the 15s safety timeout, so it can never get stuck. -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/frianzo_dark_bg"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Frianzo"
            android:src="@mipmap/ic_launcher" />

        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:indeterminateTint="#64748b" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading…"
            android:textColor="#64748b"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
