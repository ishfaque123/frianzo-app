<resources>
    <style name="Theme.Frianzo" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/frianzo_navy</item>
        <item name="colorPrimaryDark">@color/frianzo_navy</item>
        <item name="colorAccent">@color/frianzo_gold</item>
        <item name="android:statusBarColor">@color/frianzo_navy</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

    <style name="Theme.Frianzo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/frianzo_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Frianzo</item>
    </style>
</resources>
